# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (also the CSRF Origin allow-list).
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://qyou:qyou_dev_password@localhost:5452/qyou?schema=public

# Public URL of the web app (used for links in emails).
WEB_BASE_URL=http://localhost:3000
# Reverse proxies whose X-Forwarded-For is trusted. 1 locally: the Next.js dev server proxies /api.
TRUST_PROXY=1

# Local email goes to Mailpit (docker compose): SMTP localhost:1052, inbox UI http://localhost:8052
SMTP_HOST=localhost
SMTP_PORT=1052
SMTP_SECURE=false
MAIL_FROM="Qyou <no-reply@qyou.local>"
