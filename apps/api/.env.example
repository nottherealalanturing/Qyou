# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (also the CSRF Origin allow-list).
CORS_ORIGINS=http://localhost:3000
# Runtime connection: the least-privilege role (create it with `pnpm db:roles`). It cannot alter
# tables, disable triggers, or modify audit_logs.
DATABASE_URL=postgresql://qyou_runtime:qyou_runtime_dev_password@localhost:5452/qyou?schema=public
# Prisma CLI only (migrate/generate): the table-owner role. The API never reads it. It shares this
# file locally for convenience; in any DEPLOYED environment do not give the API process this URL.
MIGRATION_DATABASE_URL=postgresql://qyou:qyou_dev_password@localhost:5452/qyou?schema=public

# Public URL of the web app (used for links in emails).
WEB_BASE_URL=http://localhost:3000
# Reverse proxies whose X-Forwarded-For is trusted. 1 locally: the Next.js dev server proxies /api.
TRUST_PROXY=1

# Local email goes to Mailpit (docker compose): SMTP localhost:1052, inbox UI http://localhost:8052
SMTP_HOST=localhost
SMTP_PORT=1052
SMTP_SECURE=false
MAIL_FROM="Qyou <no-reply@qyou.local>"

# Phone verification (assistants). There is NO real SMS provider yet (docs/DECISIONS.md D-038).
# dev  = emails the code to Mailpit labelled SIMULATED (default outside production; refused in production)
# none = phone verification answers 503 and creates no code (the only value production accepts)
SMS_PROVIDER=dev
# Required in production: >= 32 random characters (HMAC key for phone codes). Leave unset locally.
# PHONE_CODE_PEPPER=
