// Qyou data model. Phase 0 contains only the identity root; Phase 1 extends it.
// Domain concepts (service request, quote, booking, payment, payout, wait report,
// virtual ticket) are deliberately separate models — see docs/ARCHITECTURE.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ASSISTANT
  BUSINESS_STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Normalised (NFKC, trimmed, lower-cased) by the application before every write/lookup.
  email           String     @unique
  name            String     @db.VarChar(80)
  /// Argon2id PHC string. Never returned by any API response, never logged.
  passwordHash    String
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  /// Set when the user proves control of `email` (verification link or password reset).
  emailVerifiedAt DateTime?  @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

/// Database-backed login session. The cookie carries an opaque 256-bit random token;
/// only its SHA-256 hash is stored here, so a database leak does not yield usable sessions.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  userAgent  String?   @db.VarChar(255)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  /// Absolute expiry; the session cannot be extended past this.
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use, short-lived password-reset token (SHA-256 hash only).
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Append-only record of security- and money-relevant actions.
/// Must never contain passwords, tokens, hashes or other secrets.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Deliberately NOT a foreign key: audit rows must survive (and never be modified by) user
  /// deletion. See docs/ARCHITECTURE.md "Audit-log integrity".
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(80)
  targetType  String?  @db.VarChar(40)
  targetId    String?  @db.VarChar(64)
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Single-use, expiring email-verification token (SHA-256 hash only). `email` pins the token to
/// the address it was sent to, so it can never verify a different address after a change.
model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  email     String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Shared fixed-window counters behind the rate limiter, so limits hold across API instances.
/// `key` is a SHA-256 of the logical key (no raw emails/IPs at rest).
model RateLimitCounter {
  key         String   @db.Char(64)
  windowStart DateTime @db.Timestamptz(3)
  count       Int

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_counters")
}
