// Qyou data model. Phase 0 contains only the identity root; Phase 1 extends it.
// Domain concepts (service request, quote, booking, payment, payout, wait report,
// virtual ticket) are deliberately separate models — see docs/ARCHITECTURE.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ASSISTANT
  BUSINESS_STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Normalised (NFKC, trimmed, lower-cased) by the application before every write/lookup.
  email           String     @unique
  name            String     @db.VarChar(80)
  /// Argon2id PHC string. Never returned by any API response, never logged.
  passwordHash    String
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  /// Set when the user proves control of `email` (verification link or password reset).
  emailVerifiedAt DateTime?  @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  assistantProfile        AssistantProfile?
  identityChecksRecorded  IdentityCheck[]

  @@map("users")
}

/// Database-backed login session. The cookie carries an opaque 256-bit random token;
/// only its SHA-256 hash is stored here, so a database leak does not yield usable sessions.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  userAgent  String?   @db.VarChar(255)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  /// Absolute expiry; the session cannot be extended past this.
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use, short-lived password-reset token (SHA-256 hash only).
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Append-only record of security- and money-relevant actions.
/// Must never contain passwords, tokens, hashes or other secrets.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Deliberately NOT a foreign key: audit rows must survive (and never be modified by) user
  /// deletion. See docs/ARCHITECTURE.md "Audit-log integrity".
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(80)
  targetType  String?  @db.VarChar(40)
  targetId    String?  @db.VarChar(64)
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Single-use, expiring email-verification token (SHA-256 hash only). `email` pins the token to
/// the address it was sent to, so it can never verify a different address after a change.
model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  email     String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Shared fixed-window counters behind the rate limiter, so limits hold across API instances.
/// `key` is a SHA-256 of the logical key (no raw emails/IPs at rest).
model RateLimitCounter {
  key         String   @db.Char(64)
  windowStart DateTime @db.Timestamptz(3)
  count       Int

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_counters")
}

// ───────────────────────── Reference data (M1.3) ─────────────────────────
// Public to read, admin-only to write, always audited. See docs/ARCHITECTURE.md
// "Reference data model". CHECK constraints (hand-written in the migration) enforce the task
// eligibility invariants, slug format and coordinate ranges.

enum TaskKind {
  QUEUE_HOLDING
  ERRAND
}

enum TaskEligibility {
  ELIGIBLE
  REQUIRES_AUTHORIZATION
  NOT_DELEGABLE
}

enum LocationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum RestrictionRule {
  PROHIBITED
  REQUIRES_AUTHORIZATION
  ADVISORY
}

/// A launch city. Deliberately NOT a venue: venues are ServiceLocation rows inside a city.
model City {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique @db.VarChar(60)
  name      String   @db.VarChar(80)
  state     String   @db.VarChar(80)
  /// Approximate city centre.
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  timezone  String   @default("Africa/Lagos") @db.VarChar(40)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  locations      ServiceLocation[]
  assistantAreas AssistantServiceArea[]

  @@unique([state, name])
  @@index([isActive, sortOrder])
  @@map("cities")
}

model ServiceCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(80)
  /// lower(trim(name)), maintained by the application: case-insensitive uniqueness.
  nameKey     String   @unique @db.VarChar(80)
  description String   @db.VarChar(500)
  /// Key into the web app's icon set (presentation hint only).
  iconKey     String   @db.VarChar(30)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  tasks     EligibleTask[]
  locations ServiceLocation[]

  @@index([isActive, sortOrder])
  @@map("service_categories")
}

model EligibleTask {
  id                       String          @id @default(uuid(7)) @db.Uuid
  categoryId               String          @db.Uuid
  slug                     String          @db.VarChar(60)
  name                     String          @db.VarChar(100)
  nameKey                  String          @db.VarChar(100)
  description              String          @db.VarChar(500)
  kind                     TaskKind
  eligibility              TaskEligibility
  requiresPersonalPresence Boolean         @default(false)
  requiresCredentials      Boolean         @default(false)
  /// Mandatory when eligibility = REQUIRES_AUTHORIZATION: exactly what the customer must provide.
  authorizationNotes       String?         @db.VarChar(1000)
  /// Mandatory when eligibility = NOT_DELEGABLE: why it cannot be done.
  restrictionNotes         String?         @db.VarChar(1000)
  isActive                 Boolean         @default(true)
  sortOrder                Int             @default(0)
  createdAt                DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @db.Timestamptz(3)

  category        ServiceCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  restrictions    LocationRestriction[]
  assistantOffers AssistantTaskOffer[]

  @@unique([categoryId, slug])
  @@unique([categoryId, nameKey])
  @@index([categoryId, isActive, sortOrder])
  @@map("eligible_tasks")
}

/// A real venue entered by an administrator. Starts empty: nothing is invented.
model ServiceLocation {
  id         String         @id @default(uuid(7)) @db.Uuid
  cityId     String         @db.Uuid
  categoryId String         @db.Uuid
  slug       String         @unique @db.VarChar(100)
  name       String         @db.VarChar(120)
  address    String         @db.VarChar(250)
  latitude   Decimal?       @db.Decimal(9, 6)
  longitude  Decimal?       @db.Decimal(9, 6)
  status     LocationStatus @default(PENDING_REVIEW)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)

  city         City                  @relation(fields: [cityId], references: [id], onDelete: Restrict)
  category     ServiceCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  restrictions LocationRestriction[]

  @@index([cityId, status])
  @@index([categoryId, status])
  @@index([status, name])
  @@map("service_locations")
}

/// Venue-specific rule. `taskId = null` applies to the whole venue.
model LocationRestriction {
  id         String          @id @default(uuid(7)) @db.Uuid
  locationId String          @db.Uuid
  taskId     String?         @db.Uuid
  rule       RestrictionRule
  note       String          @db.VarChar(500)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  location ServiceLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  task     EligibleTask?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // NULLS NOT DISTINCT is applied by hand in the migration (Prisma cannot express it).
  @@unique([locationId, taskId, rule])
  @@index([locationId])
  @@map("location_restrictions")
}

// ───────────────────── Assistants (M1.4) ─────────────────────
// Public profile data, private details and verification outcomes live in SEPARATE tables.
// Raw identity documents are never stored here (no storage exists; outcomes only).
// See docs/ARCHITECTURE.md "Assistants: profiles, onboarding and verification".

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

/// PENDING means "no outcome recorded yet"; recorded checks are PASSED, FAILED or INCONCLUSIVE.
enum IdentityOutcome {
  PENDING
  PASSED
  FAILED
  INCONCLUSIVE
}

enum IdentityMethod {
  MANUAL_REVIEW
}

/// Intentionally public marketplace information plus the application workflow state.
model AssistantProfile {
  id               String            @id @default(uuid(7)) @db.Uuid
  userId           String            @unique @db.Uuid
  /// Public URL handle: name + random suffix. Immutable.
  slug             String            @unique @db.VarChar(80)
  displayName      String            @db.VarChar(60)
  bio              String            @default("") @db.VarChar(600)
  /// Spoken languages, from a fixed list validated by the API.
  languages        String[]          @default([])
  /// Short free text shown with the declared availability.
  availabilityNote String?           @db.VarChar(200)
  timezone         String            @default("Africa/Lagos") @db.VarChar(40)
  status           ApplicationStatus @default(DRAFT)
  /// The latest reason given by an administrator (shown to the assistant, never public).
  statusReason     String?           @db.VarChar(500)
  statusChangedAt  DateTime          @default(now()) @db.Timestamptz(3)
  submittedAt      DateTime?         @db.Timestamptz(3)
  approvedAt       DateTime?         @db.Timestamptz(3)
  /// Denormalised latest identity-check outcome (history is in identity_checks).
  identityOutcome  IdentityOutcome   @default(PENDING)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  user           User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  privateDetails AssistantPrivateDetails?
  serviceAreas   AssistantServiceArea[]
  taskOffers     AssistantTaskOffer[]
  availability   AssistantAvailabilityWindow[]
  identityChecks IdentityCheck[]
  phoneTokens    PhoneVerificationToken[]

  @@index([status, createdAt])
  @@index([status, identityOutcome])
  @@map("assistant_profiles")
}

/// PRIVATE: returned only to the owner and to reviewing administrators. Never joined by public queries.
model AssistantPrivateDetails {
  id              String    @id @default(uuid(7)) @db.Uuid
  profileId       String    @unique @db.Uuid
  legalName       String?   @db.VarChar(120)
  /// E.164, Nigerian numbers only at launch (+234 and 10 digits).
  phoneE164       String?   @db.VarChar(16)
  phoneVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  profile AssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // A partial unique index (verified phones only) is added by hand in the migration.
  @@map("assistant_private_details")
}

model AssistantServiceArea {
  profileId String @db.Uuid
  cityId    String @db.Uuid

  profile AssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  city    City             @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@id([profileId, cityId])
  @@index([cityId])
  @@map("assistant_service_areas")
}

/// A task the assistant offers. A trigger refuses NOT_DELEGABLE tasks (see migration).
model AssistantTaskOffer {
  profileId String @db.Uuid
  taskId    String @db.Uuid

  profile AssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  task    EligibleTask     @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([profileId, taskId])
  @@index([taskId])
  @@map("assistant_task_offers")
}

/// Preferred working window — a declaration, NOT a guarantee that work is available.
model AssistantAvailabilityWindow {
  id          String @id @default(uuid(7)) @db.Uuid
  profileId   String @db.Uuid
  /// 0 = Sunday … 6 = Saturday.
  dayOfWeek   Int
  /// Minutes from local midnight, 0..1440; start < end.
  startMinute Int
  endMinute   Int

  profile AssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, dayOfWeek])
  @@map("assistant_availability_windows")
}

/// One phone-verification attempt. The 6-digit code is stored only as an HMAC.
model PhoneVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  profileId String    @db.Uuid
  phoneE164 String    @db.VarChar(16)
  codeHash  String    @db.Char(64)
  attempts  Int       @default(0)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  profile AssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([expiresAt])
  @@map("phone_verification_tokens")
}

/// An identity-check OUTCOME recorded by an administrator. No documents, selfies or ID numbers are
/// stored; `evidenceRef` is an opaque pointer to wherever the reviewer's evidence is held off-system.
model IdentityCheck {
  id              String          @id @default(uuid(7)) @db.Uuid
  profileId       String          @db.Uuid
  result          IdentityOutcome
  method          IdentityMethod  @default(MANUAL_REVIEW)
  evidenceRef     String?         @db.VarChar(120)
  notes           String?         @db.VarChar(500)
  checkedByUserId String          @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  profile   AssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  checkedBy User             @relation(fields: [checkedByUserId], references: [id], onDelete: Restrict)

  @@index([profileId, createdAt])
  @@map("identity_checks")
}
