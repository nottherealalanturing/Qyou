{
  "name": "qyou",
  "private": true,
  "version": "0.0.0",
  "description": "Qyou \u2014 a queue-assistance marketplace",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @qyou/api --filter @qyou/web dev",
    "dev:api": "pnpm --filter @qyou/api dev",
    "dev:web": "pnpm --filter @qyou/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "db:up": "docker compose up -d --wait postgres mailpit",
    "db:down": "docker compose down",
    "db:roles": "docker compose exec -T postgres psql -U qyou -d postgres -v ON_ERROR_STOP=1 -f - < docker/dev-db-roles.sql",
    "db:migrate": "pnpm --filter @qyou/api db:migrate",
    "db:deploy:test": "pnpm --filter @qyou/api db:deploy:test",
    "db:deploy": "pnpm --filter @qyou/api db:deploy",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "verify:headers": "pnpm --filter @qyou/web verify:headers",
    "e2e:browsers": "pnpm --filter @qyou/e2e browsers",
    "e2e:build": "pnpm --filter @qyou/e2e prepare:e2e",
    "e2e": "pnpm --filter @qyou/e2e e2e"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
